# -------------------------------------------------------------
# 🚀 CAMPUS MARKETPLACE FRONTEND — .gitignore
# -------------------------------------------------------------

# Node dependencies
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# Build outputs
dist/
build/
storybook-static/
.vite/
**/node_modules/.vite

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug*.log

# Environment files (keep .env.example for reference)
.env
.env.local
.env.development
.env.production
.env.*
!.env.example

# IDE / Editor settings
.vscode/
.idea/
*.swp

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Test coverage / reports
coverage/
.cypress/
cypress/screenshots/
cypress/videos/
playwright-report/
test-results/

# Git / CI metadata
.gitlab-ci.yml
.github/
.gitignore
.gitattributes

# Temporary files
*.tmp
*.temp
*.bak

# Package lock (optional to ignore if team uses same npm)
# comment/uncomment depending on your workflow
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Docker artifacts
Dockerfile*
.dockerignore

# Deployment / Hosting outputs
.vercel/
.netlify/
firebase-debug.log

# Optional: local config overrides
*.local.json

# -------------------------------------------------------------
# ✅ END
# -------------------------------------------------------------
